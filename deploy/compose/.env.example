# `make env` generates .env with random values. Optional overrides:
# SC_CONSOLE_PORT=3100
# SC_API_PORT=8180
# SC_REDIS_PORT=6479
# SC_FLOCI_PORT=4666
# MOCK_LATENCY_MS=700
#
# Use a real provider instead of the mock:
# SC_UPSTREAM_BASE_URL=https://api.openai.com/v1
# SC_UPSTREAM_API_KEY=sk-...
# SC_EMBEDDER=openai            # true semantic matching through the provider's /embeddings
SC_API_KEY_PEPPER=change-me-to-a-long-random-string
SC_BOOTSTRAP_API_KEY=sc_local001_change-me
