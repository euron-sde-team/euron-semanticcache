# Base URL of the SemanticCache API, as seen from the browser.
NEXT_PUBLIC_SC_API_URL=http://localhost:8180
# LOCAL DEMOS ONLY: pre-fills the connect form. Never set this for a shared deployment,
# because NEXT_PUBLIC_* values are shipped to every visitor's browser.
# NEXT_PUBLIC_SC_DEFAULT_API_KEY=sc_demo0000_local-only-key
